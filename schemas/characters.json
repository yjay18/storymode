{
  "$defs": {
    "BackgroundDefinition": {
      "additionalProperties": false,
      "description": "A selectable protagonist background.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "stat_bonus": {
          "$ref": "#/$defs/StatName"
        },
        "stat_bonus_value": {
          "maximum": 2,
          "minimum": 1,
          "title": "Stat Bonus Value",
          "type": "integer"
        },
        "starting_skill_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "title": "Starting Skill Ids",
          "type": "array"
        },
        "starting_item_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "title": "Starting Item Ids",
          "type": "array"
        },
        "starting_fact_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{2,63}$",
            "type": "string"
          },
          "title": "Starting Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "stat_bonus",
        "stat_bonus_value",
        "starting_skill_ids",
        "starting_item_ids",
        "starting_fact_ids"
      ],
      "title": "BackgroundDefinition",
      "type": "object"
    },
