  "additionalProperties": false,
  "description": "The root characters file structure.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "campaign_id": {
      "pattern": "^[a-z][a-z0-9_-]{2,63}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "campaign_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "title": "Campaign Version",
      "type": "string"
    },
    "protagonist_backgrounds": {
      "items": {
        "$ref": "#/$defs/BackgroundDefinition"
      },
      "title": "Protagonist Backgrounds",
      "type": "array"
    },
    "major_npcs": {
      "items": {
        "$ref": "#/$defs/MajorNpcDefinition"
      },
      "title": "Major Npcs",
      "type": "array"
    },
    "companions": {
      "items": {
        "$ref": "#/$defs/CompanionDefinition"
      },
      "title": "Companions",
      "type": "array"
    }
  },
  "required": [
    "campaign_id",
    "campaign_version",
    "protagonist_backgrounds",
    "major_npcs",
    "companions"
  ],
  "title": "CharactersFile",
  "type": "object"
