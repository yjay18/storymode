        "strength",
        "dexterity",
        "intelligence",
        "charisma",
        "constitution",
        "wisdom"
      ],
      "title": "StatBlock",
      "type": "object"
    },
    "StatName": {
      "description": "The six core statistics.",
      "enum": [
        "strength",
        "dexterity",
        "intelligence",
        "charisma",
        "constitution",
        "wisdom"
      ],
      "title": "StatName",
      "type": "string"
    }
