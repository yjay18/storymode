        "name",
        "role",
        "home_area_id",
        "knowledge_tags",
        "goal",
        "interaction_hooks",
        "combat_role",
        "base_stats",
        "skill_tree_id",
        "starting_skill_ids",
        "starting_loadout",
        "relationship_rules",
        "story_hook_ids",
        "availability_rules",
        "minimum_usable_actions"
