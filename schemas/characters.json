    "StatBlock": {
      "additionalProperties": false,
      "description": "Exact six statistics for a character.",
      "properties": {
        "strength": {
          "maximum": 30,
          "minimum": 1,
          "title": "Strength",
          "type": "integer"
        },
        "dexterity": {
          "maximum": 30,
          "minimum": 1,
          "title": "Dexterity",
          "type": "integer"
        },
        "intelligence": {
          "maximum": 30,
          "minimum": 1,
          "title": "Intelligence",
          "type": "integer"
        },
        "charisma": {
          "maximum": 30,
          "minimum": 1,
          "title": "Charisma",
          "type": "integer"
        },
        "constitution": {
          "maximum": 30,
          "minimum": 1,
          "title": "Constitution",
          "type": "integer"
        },
        "wisdom": {
          "maximum": 30,
          "minimum": 1,
          "title": "Wisdom",
          "type": "integer"
        }
